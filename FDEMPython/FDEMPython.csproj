<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>disable</Nullable>
	<!-- Ensure all transitive dependency assemblies (FDEMCore, its NuGet packages, etc.)
		 are copied to the build/publish output so that Python.NET can locate and load
		 them alongside FDEMPython.dll. -->
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<!-- Class libraries do not emit a runtimeconfig.json by default. Python.NET (clr_loader)
		 needs FDEMPython.runtimeconfig.json to host the correct CoreCLR version (net10.0)
		 instead of falling back to an older installed runtime that may not fully support it. -->
	<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	<AssemblyTitle>FDEMPython</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\FDEMCore\FDEMCore.csproj" />
  </ItemGroup>

</Project>
